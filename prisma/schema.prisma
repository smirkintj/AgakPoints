generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (NextAuth v5) ---

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  image        String?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- App Models ---

model Product {
  id                 String         @id @default(cuid())
  name               String
  adminId            String
  admin              User           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jiraBaseUrl        String?
  jiraProjectKey     String?
  jiraApiToken       String?
  jiraEmail          String?
  jiraBoardId        String?
  confluenceBaseUrl  String?
  confluenceSpaceKey String?
  confluenceToken    String?
  confluenceEmail    String?
  tagPresets         String[]
  dependencyTypes    String[]
  members            Member[]
  pokerSessions      PokerSession[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Member {
  id              String               @id @default(cuid())
  productId       String
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  avatarUrl       String?
  role            MemberRole           @default(DEV)
  capacity        Int                  @default(20)
  country         String?
  votes           Vote[]
  participants    SessionParticipant[]
  achievements    Achievement[]
  assignedTickets Ticket[]             @relation("TicketAssignee")
  createdAt       DateTime             @default(now())

  @@index([productId])
}

enum MemberRole {
  DEV
  QA
  UI_UX
  SM
  TECH_LEAD
}

model PokerSession {
  id              String               @id @default(cuid())
  productId       String
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sprintId        String
  sprintName      String
  name            String?
  shortCode       String?              @unique
  status          SessionStatus        @default(WAITING)
  sprintStartDate DateTime?
  sprintEndDate   DateTime?
  tickets         Ticket[]
  participants    SessionParticipant[]
  createdAt       DateTime             @default(now())
  completedAt     DateTime?

  @@index([productId])
}

enum SessionStatus {
  WAITING
  ACTIVE
  COMPLETED
}

model SessionParticipant {
  id        String       @id @default(cuid())
  sessionId String
  session   PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedIn Boolean      @default(false)
  joinedAt  DateTime     @default(now())

  @@unique([sessionId, memberId])
  @@index([sessionId])
  @@index([memberId])
}

model Ticket {
  id            String       @id @default(cuid())
  sessionId     String
  session       PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  jiraKey       String
  title         String
  description   String?
  status        TicketStatus @default(PENDING)
  finalEstimate Int?
  adminNote     String?
  order         Int
  assigneeId            String?
  assignee              Member?      @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  issueType             String?
  jiraAssigneeName      String?
  jiraAssigneeAccountId String?
  contextNote           String?
  priority              String?
  designReadiness  DesignReadiness?
  designComplexity DesignComplexity?
  designLink       String?
  tags             String[]
  votes                 Vote[]
  createdAt             DateTime     @default(now())

  @@index([sessionId])
}

enum DesignReadiness {
  READY
  IN_PROGRESS
  NOT_STARTED
}

enum DesignComplexity {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  PENDING
  VOTING
  REVEALED
  ESTIMATED
}

model Vote {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([ticketId, memberId])
  @@index([ticketId])
  @@index([memberId])
}

model Achievement {
  id        String          @id @default(cuid())
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      AchievementType
  sessionId String
  earnedAt  DateTime        @default(now())
}

enum AchievementType {
  SNIPER
  WILDCARD
  SPEEDSTER
  FIRST_BLOOD
  ON_FIRE
  TEAM_PLAYER
}

model SprintLeave {
  id        String   @id @default(cuid())
  sessionId String
  memberId  String
  date      String   // ISO date YYYY-MM-DD
  createdAt DateTime @default(now())

  @@unique([sessionId, memberId, date])
  @@index([sessionId])
  @@index([memberId])
}

model SprintHoliday {
  id        String   @id @default(cuid())
  sessionId String
  date      String
  name      String
  type      String   @default("PH")
  country   String?
  createdAt DateTime @default(now())

  @@unique([sessionId, date])
  @@index([sessionId])
}
