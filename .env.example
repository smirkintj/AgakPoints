# Neon Postgres
DATABASE_URL="postgresql://..."

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Partykit — after deploy, will be: agakpoints.<your-username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST="localhost:1999"
# HMAC secret shared between Next.js and PartyKit for admin token verification
# Generate with: openssl rand -hex 32
# Must also be set as a PartyKit secret: npx partykit env add PARTYKIT_SECRET
PARTYKIT_SECRET="your-partykit-secret-here"

# AES-256-GCM key for encrypting Jira/Confluence tokens at rest (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY="64-character-hex-string-here"
