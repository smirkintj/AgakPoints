generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (NextAuth v5) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// --- App Models ---

model Product {
  id                 String         @id @default(cuid())
  name               String
  adminId            String
  admin              User           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  jiraBaseUrl        String?
  jiraProjectKey     String?
  jiraApiToken       String?
  jiraEmail          String?
  jiraBoardId        String?
  confluenceBaseUrl  String?
  confluenceSpaceKey String?
  confluenceToken    String?
  confluenceEmail    String?
  members            Member[]
  pokerSessions      PokerSession[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Member {
  id           String               @id @default(cuid())
  productId    String
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  avatarUrl    String?
  role         MemberRole           @default(DEV)
  votes        Vote[]
  participants SessionParticipant[]
  achievements Achievement[]
  createdAt    DateTime             @default(now())
}

enum MemberRole {
  DEV
  QA
  UI_UX
  SM
  TECH_LEAD
}

model PokerSession {
  id           String               @id @default(cuid())
  productId    String
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sprintId     String
  sprintName   String
  status       SessionStatus        @default(WAITING)
  tickets      Ticket[]
  participants SessionParticipant[]
  createdAt    DateTime             @default(now())
  completedAt  DateTime?
}

enum SessionStatus {
  WAITING
  ACTIVE
  COMPLETED
}

model SessionParticipant {
  id        String       @id @default(cuid())
  sessionId String
  session   PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedIn Boolean      @default(false)
  joinedAt  DateTime     @default(now())

  @@unique([sessionId, memberId])
}

model Ticket {
  id            String       @id @default(cuid())
  sessionId     String
  session       PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  jiraKey       String
  title         String
  description   String?
  status        TicketStatus @default(PENDING)
  finalEstimate Int?
  adminNote     String?
  order         Int
  votes         Vote[]
  createdAt     DateTime     @default(now())
}

enum TicketStatus {
  PENDING
  VOTING
  REVEALED
  ESTIMATED
}

model Vote {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([ticketId, memberId])
}

model Achievement {
  id        String          @id @default(cuid())
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      AchievementType
  sessionId String
  earnedAt  DateTime        @default(now())
}

enum AchievementType {
  SNIPER
  WILDCARD
  SPEEDSTER
  FIRST_BLOOD
  ON_FIRE
  TEAM_PLAYER
}
